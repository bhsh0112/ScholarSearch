## 数据库（V1 默认用 SQLite：本地零依赖；上线可切换到 Postgres）
DATABASE_URL="file:./dev.db"

## V1：单用户模式（先跑通检索/追踪闭环；后续可替换为完整账号体系）
APP_USER_EMAIL="you@example.com"
APP_PROJECT_NAME="My Research"
## 可选：用于 seed 默认用户设置初始密码
APP_USER_PASSWORD=""

## 邮件（可选：不配置则只站内通知）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ScholarSearch <no-reply@example.com>"

## 追踪任务（本地开发用；生产建议设置为高强度随机字符串）
CRON_SECRET="dev"
APP_BASE_URL="http://localhost:3000"

## AI（可选）：OpenAI-compatible Chat Completions
## 说明：会把用户的 query 发给第三方模型服务，用于生成“检索式草案 + filters”
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

## 订阅计划（可选）：若数据库中存在有效订阅 Subscription，则优先生效；否则回退 APP_PLAN
## 可选：FREE / PRO / MAX
APP_PLAN="FREE"

## 账号系统：Session 过期天数（默认 30）
SESSION_TTL_DAYS="30"

## 邮箱验证/重置密码 token 过期时间（可选）
EMAIL_VERIFY_TTL_HOURS="24"
PASSWORD_RESET_TTL_MINUTES="30"

## 支付：支付宝（当面付 / 预创建）
## 用于：/pricing 扫码支付 + /api/pay/alipay/notify 回调开通订阅
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
## 需要是公网 HTTPS 可访问的回调地址（生产环境）
ALIPAY_NOTIFY_URL="https://your-domain.com/api/pay/alipay/notify"

## 支付：微信支付 V3（Native 扫码）
## 用于：/pricing 扫码支付 + /api/pay/wechat/notify 回调开通订阅
WECHATPAY_MCH_ID=""
WECHATPAY_APP_ID=""
WECHATPAY_SERIAL_NO=""
WECHATPAY_PRIVATE_KEY_PEM=""
WECHATPAY_API_V3_KEY=""
WECHATPAY_PLATFORM_CERT_PEM=""
WECHATPAY_PLATFORM_SERIAL=""
## 需要是公网 HTTPS 可访问的回调地址（生产环境）
WECHATPAY_NOTIFY_URL="https://your-domain.com/api/pay/wechat/notify"

## 本地/测试机联调提示（回调必须公网可达）
## - 你可以用内网穿透（例如 cloudflared / ngrok）把本地 3000 暴露为 https://xxxx.trycloudflare.com
## - 然后把 ALIPAY_NOTIFY_URL / WECHATPAY_NOTIFY_URL 临时指向该公网 URL
## - 等正式部署到有公网 HTTPS 的服务器，再把 notify_url 改回你的域名


