// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  /// 说明：在 Windows + Next.js(moduleResolution=bundler) 场景下，
  /// Prisma 默认生成到 `node_modules/.prisma/client` 可能导致类型解析不稳定。
  /// 显式把输出放到 `@prisma/client/.prisma/client`，保证 `@prisma/client` 的
  /// `export * from '.prisma/client/default'` 能稳定解析到正确的生成产物。
  output   = "../node_modules/@prisma/client/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 数据源枚举：V1 仅接入开放英文库
enum WorkSourceType {
  OPENALEX
  CROSSREF
  ARXIV
}

/// 任务调度：用于 SavedSearch 的追踪频率
enum SavedSearchSchedule {
  MANUAL
  DAILY
  WEEKLY
}

/// 推送策略：控制“日常推送”排序偏好
enum PushStrategy {
  /// 最新优先：更看重时效（Radar）
  RECENCY
  /// 重要性优先：更看重“值得看”（Digest）
  IMPORTANCE
  /// 平衡：默认档（Hybrid）
  HYBRID
}

/// 噪音控制：控制推送的“严格/宽松”程度（V1.5：简单规则）
enum NoiseLevel {
  STRICT
  STANDARD
  LOOSE
}

/// 通知类型：V1 只有“追踪到新论文”
enum NotificationType {
  NEW_WORKS
}

/// 用户对推送条目的反馈（用于个性化）
enum FeedbackAction {
  /// 相关：轻微正反馈
  RELEVANT
  /// 不相关：强负反馈
  NOT_RELEVANT
  /// 更多类似：强正反馈（用于学习偏好）
  MORE_LIKE_THIS
  /// 更少类似：强负反馈（用于学习偏好）
  LESS_LIKE_THIS
}

/// 主题偏好维度：用于规则版排序增益
enum PreferenceKind {
  AUTHOR
  VENUE
  KEYWORD
}

/// 支付渠道
enum PaymentProvider {
  WECHAT
  ALIPAY
}

/// 支付订单状态
enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

/// 订阅周期
enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// 订阅状态
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  projects      Project[]
  notifications Notification[]
  feedbacks     WorkFeedback[]
  preferences   TopicPreference[]
  orders        PaymentOrder[]
  subscriptions Subscription[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  savedSearches SavedSearch[]

  @@index([userId])
}

/// 保存检索：用于日常/每周追踪增量
model SavedSearch {
  id        String   @id @default(cuid())
  name      String
  query     String
  filters   Json?
  active    Boolean  @default(true)
  schedule  SavedSearchSchedule @default(DAILY)
  /// 推送偏好：最新/重要性/混合
  pushStrategy PushStrategy @default(HYBRID)
  /// 推送数量上限：用于“日常推送/邮件摘要”
  pushTopN     Int          @default(10)
  /// 噪音控制：严格/标准/宽松（用于过滤低质量/重复轰炸）
  noiseLevel   NoiseLevel   @default(STANDARD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 上次追踪检查时间（用于差分）
  lastCheckedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  runs           SearchRun[]
  savedSearchWorks SavedSearchWork[]
  feedbacks        WorkFeedback[]
  preferences      TopicPreference[]

  @@index([projectId])
  @@index([active, schedule, lastCheckedAt])
}

/// 每一次检索/追踪运行的记录（用于可复现与统计）
model SearchRun {
  id        String   @id @default(cuid())
  runAt     DateTime @default(now())
  query     String
  filters   Json?
  sources   Json?
  stats     Json?
  error     String?

  savedSearchId String?
  savedSearch   SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)

  @@index([savedSearchId, runAt])
}

/// 统一论文实体（canonical work）
model Work {
  id        String   @id @default(cuid())
  title     String
  abstract  String?
  year      Int?
  venue     String?
  url       String?

  /// 标识符（用于高精度去重）
  doi       String?  @unique
  arxivId   String?  @unique
  openalexId String? @unique

  /// 归一化字段（用于标题相似去重）
  normalizedTitle String

  authors Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources WorkSource[]
  savedSearchWorks SavedSearchWork[]
  feedbacks WorkFeedback[]

  @@index([year])
  @@index([normalizedTitle])
}

/// 单条来源记录：保留每个数据源的原始/半原始信息，便于可追溯与后续修复
model WorkSource {
  id        String   @id @default(cuid())
  source    WorkSourceType
  sourceId  String
  url       String?
  raw       Json?
  fetchedAt DateTime @default(now())

  workId String
  work   Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([workId])
}

/// 追踪集合中的“已见过”关系：用于差分（new works）
model SavedSearchWork {
  id        String   @id @default(cuid())
  firstSeenAt DateTime @default(now())

  savedSearchId String
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  workId String
  work   Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, workId])
  @@index([savedSearchId, firstSeenAt])
}

/// 用户对某条 work（在某个主题下）的反馈
model WorkFeedback {
  id        String   @id @default(cuid())
  action    FeedbackAction
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  savedSearchId String
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  workId String
  work   Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, savedSearchId, workId])
  @@index([userId, savedSearchId, updatedAt])
}

/// 主题偏好：用来做规则版推荐增益（作者/venue/关键词）
model TopicPreference {
  id        String   @id @default(cuid())
  kind      PreferenceKind
  value     String
  weight    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  savedSearchId String
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@unique([userId, savedSearchId, kind, value])
  @@index([userId, savedSearchId, kind])
}

/// 支付订单（单用户模式下仍然按 user 归属，便于后续多用户扩展）
model PaymentOrder {
  id        String            @id @default(cuid())
  provider  PaymentProvider
  status    PaymentOrderStatus @default(PENDING)
  planId    String
  period    BillingPeriod
  amountCny Int

  /// 商户侧订单号（out_trade_no / out_trade_no）
  outTradeNo String @unique

  /// 第三方交易号（支付平台侧订单号）
  providerTradeNo String?

  /// 扫码支付链接（微信 code_url / 支付宝 qr_code）
  qrCodeUrl String?

  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// 订阅（用于计算当前计划）
model Subscription {
  id        String             @id @default(cuid())
  status    SubscriptionStatus @default(ACTIVE)
  planId    String
  startedAt DateTime           @default(now())
  currentPeriodEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, currentPeriodEnd])
}

model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  data      Json?
  createdAt DateTime @default(now())
  readAt    DateTime?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
