# Root .gitignore for ScholarSearch
# - Web app lives in /web (Next.js)
# - SQLite is used by default for local dev

# --- Dependencies ---
**/node_modules/

# --- Next.js / build outputs ---
web/.next/
web/out/
web/build/
web/.turbo/

# --- Logs ---
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# --- Environment files ---
**/.env
**/.env.*

# --- Databases / local state ---
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3

# --- Prisma generated / local engines ---
web/node_modules/.prisma/

# --- OS / IDE ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

.vscode/
.idea/
*.iml

# --- Misc secrets / certs ---
*.pem
*.key
*.crt


